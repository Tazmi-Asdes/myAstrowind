---
import Layout from '~/layouts/PageLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'MyBlog — 个人技术博客',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero2
    isReversed
    image={{ src: '~/assets/images/tazmi.jpg', alt: 'Tazmi 头像', class: 'mx-auto rounded-2xl w-56 lg:w-72 object-contain' }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">Tazmi</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">运维实践者</span> · 服务器管理 · CI/CD · 基础设施
    </Fragment>
  </Hero2>

  <!-- 技术栈 Widget *************** -->

  <Features
    id="skills"
    tagline="技能"
    title="运维实践方向"
    items={[
      {
        title: '服务器管理',
        description: '熟练使用 1Panel 进行服务器运维，掌握 Linux 系统管理、Nginx/OpenResty 配置、防火墙策略与 DDNS 动态域名解析。独立完成从系统安装到服务上线的全流程。',
        icon: 'tabler:server',
      },
      {
        title: 'CI/CD 流水线',
        description: '搭建 Drone CI 自动化部署系统，实现代码推送即自动构建部署。解决过 YAML 解析、容器隔离、锁文件缺失等实际故障，具备完整的 CI/CD 排障经验。',
        icon: 'tabler:refresh',
      },
      {
        title: '容器化与基础设施',
        description: '掌握 Docker 容器化部署与管理，熟悉 Docker Compose 多容器编排。使用 Alpine 镜像优化 CI 构建环境，通过 Volume 卷实现构建产物与站点目录的数据同步。',
        icon: 'tabler:box',
      },
      {
        title: '问题定位与排障',
        description: '善于从日志与报错信息中定位根因，积累了大量实操经验：显卡驱动兼容性、IPv6 防火墙规则、Docker 日志清理、cron 定时任务等。',
        icon: 'tabler:search',
      },
    ]}
  />

  <!-- 博客 Widget ******************* -->

  <BlogLatestPosts title="最新文章" information="记录服务器运维、CI/CD 自动化与基础设施搭建的实践过程。" />

  <!-- 联系方式 Widget ************** -->

  <Features2
    title="与我联系"
    tagline="Contact"
    columns={2}
    items={[
      {
        title: 'GitHub',
        description: 'github.com/Tazmi-Asdes',
        icon: 'tabler:brand-github',
      },
      {
        title: '邮箱',
        description: '2926238971@qq.com',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
