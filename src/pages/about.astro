---
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '关于我',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="About" title="关于我">
    <Fragment slot="subtitle"> 林子航 · 专注服务器运维与 CI/CD 自动化 </Fragment>
  </HeroText>

  <!-- 工作领域 Widget ************** -->

  <Features
    tagline="运维实践"
    title="在校期间动手搭建的技术设施"
    columns={3}
    items={[
      {
        title: '服务器运维',
        description:
          '独立完成 Ubuntu Server 安装、LVM 分区、DDNS 解析与 IPv6 公网访问配置。使用 1Panel 管理面板，通过 OpenResty 反向代理托管站点。',
        icon: 'tabler:server',
      },
      {
        title: 'CI/CD 自动化部署',
        description:
          '自建 Drone CI 环境，编写流水线配置实现 Git Push 自动构建部署。实践中解决了 YAML 语法、容器隔离、锁文件缺失等工程问题。',
        icon: 'tabler:refresh',
      },
      {
        title: '容器化与基础设施',
        description:
          '使用 Docker 部署 Drone CI 等服务，通过 Volume 卷实现数据共享。配置文件管理服务器环境，确保可复现、可迁移。',
        icon: 'tabler:box',
      },
    ]}
  />
</Layout>
