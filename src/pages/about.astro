---
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '关于我',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="About" title="关于我">
    <Fragment slot="subtitle"> 林子航 · 专注服务器运维与 CI/CD 自动化 · 乐于实践 </Fragment>
  </HeroText>

  <!-- 工作领域 Widget ************** -->

  <Features
    tagline="运维实践"
    title="在校期间动手搭建的技术设施"
    columns={3}
    items={[
      {
        title: '服务器运维',
        description:
          '在 Windows 主机上安装 Ubuntu Server，完成从系统分区、LVM 配置到 DDNS 动态解析、IPv6 公网访问的全流程搭建。使用 1Panel 面板管理服务器，通过 OpenResty 反向代理托管静态站点。',
        icon: 'tabler:server',
      },
      {
        title: 'CI/CD 自动化部署',
        description:
          '自建 Drone CI 环境，编写 `.drone.yml` 配置实现 GitHub 推送自动触发构建部署。从环境准备到上线运行，逐一解决 YAML 语法、容器隔离、锁文件缺失等实际工程问题。',
        icon: 'tabler:refresh',
      },
      {
        title: '容器化与基础设施即代码',
        description:
          '使用 Docker 部署 Drone CI、1Panel 等服务，通过 Volume 卷实现容器间数据共享。服务器配置通过配置文件管理，确保环境可复现、迁移成本低，践行 Infrastructure as Code 理念。',
        icon: 'tabler:box',
      },
    ]}
  />
</Layout>
